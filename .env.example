# ─────────────────────────────────────────────────────────────
# MGM FARM — Anonimni kanal za prijavu neusklađenosti
# Environment varijable — kopiraj u .env i popuni stvarnim vrijednostima
# ─────────────────────────────────────────────────────────────

# ── Baza podataka ──
# Lokalni razvoj: postgresql://whistleblower:whistleblower@localhost:5432/whistleblower
# Docker:          postgresql://whistleblower:whistleblower@db:5432/whistleblower
DATABASE_URL=postgresql://whistleblower:whistleblower@localhost:5432/whistleblower

# ── JWT (admin sesije) ──
# Generiši: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── SMTP (email obavijesti) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=  # Ako lozinka ima # ili $ znakove, stavi u navodnike: "lozinka"
SMTP_FROM=noreply@mgmfarm.ba

# ── Email adrese za obavijesti ──
# Forma 1 — opšte neusklađenosti (svi admini sa pristupom ovom mailu vide prijave)
NOTIFICATION_EMAIL_GENERAL=neuskladjenost@mgmfarm.ba
# Forma 2 — prijave o direktoru/Compliance Officeru (pravni odjel)
NOTIFICATION_EMAIL_LEGAL=

# ── Rokovi (u danima) ──
FIRST_RESPONSE_DAYS=7
STATUS_UPDATE_DAYS=30

# ── Prilozi ──
MAX_ATTACHMENT_SIZE_MB=10
# Dozvoljeni MIME tipovi (razdvojeni zarezom)
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain

# ── Upload direktorij (izvan public, gitignored) ──
UPLOAD_DIR=./uploads

# ── Zadržavanje podataka (dani, 0 = ne briše automatski) ──
RETENTION_DAYS=730

# ── Aplikacija ──
PORT=3000
NODE_ENV=development

# ── Frontend (samo za Vite dev proxy) ──
VITE_API_URL=http://localhost:3000

# ── Admin seed (prvi admin korisnik) ──
# Generisi: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
