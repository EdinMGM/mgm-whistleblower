// ─────────────────────────────────────────────────────────────
// MGM FARM — Anonimni kanal za prijavu neusklađenosti
// Prisma schema — model baze podataka
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enumeracije ──

enum ReportType {
  GENERAL    // Forma 1 — neusklađenosti u organizaciji
  SENSITIVE  // Forma 2 — prijave o direktoru / Compliance Officeru
}

enum ReportStatus {
  ZAPRIMLJENA
  U_PROCJENI
  POTREBNE_INFO
  U_OBRADI
  PROSLIJEDJENA
  ZAVRSENA
  ZATVORENA
}

enum AdminRole {
  ADMIN
  INVESTIGATOR
}

enum MessageAuthor {
  REPORTER         // Prijavitelj (anoniman)
  AUTHORIZED_PERSON // Ovlaštena osoba (admin/investigator)
}

enum AttachmentUploader {
  REPORTER
  ADMIN
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// ── Modeli ──

model AdminUser {
  id                    String      @id @default(uuid())
  username              String      @unique
  passwordHash          String
  role                  AdminRole   @default(INVESTIGATOR)
  canAccessSensitive    Boolean     @default(false) @map("can_access_sensitive")
  isSuperAdmin          Boolean     @default(false) @map("is_super_admin")
  isActive              Boolean     @default(true) @map("is_active")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  assignments           ReportAssignment[]
  internalNotes         InternalNote[]
  statusChanges         StatusHistory[]
  activityLogs          ActivityLog[]
  assignedBy            ReportAssignment[] @relation("AssignedBy")

  @@map("admin_users")
}

model Report {
  id                     String       @id @default(uuid())
  referenceNumber        String       @unique @map("reference_number")
  // argon2id hash tajnog ključa — plaintext se nikada ne čuva
  secretKeyHash          String       @map("secret_key_hash")
  reportType             ReportType   @map("report_type")
  category               String
  title                  String?
  description            String
  incidentDate           DateTime?    @map("incident_date")
  location               String?
  personsInvolved        String?      @map("persons_involved")
  status                 ReportStatus @default(ZAPRIMLJENA)
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  // Rokovi se računaju pri kreiranju: created_at + FIRST_RESPONSE_DAYS / STATUS_UPDATE_DAYS
  firstResponseDeadline  DateTime     @map("first_response_deadline")
  statusUpdateDeadline   DateTime     @map("status_update_deadline")
  lastActivityAt         DateTime     @default(now()) @map("last_activity_at")
  lastResponseAt         DateTime?    @map("last_response_at")
  // Brute-force zaštita na pristupnom endpointu
  accessAttempts         Int          @default(0) @map("access_attempts")
  lockedUntil            DateTime?    @map("locked_until")

  messages               Message[]
  attachments            Attachment[]
  internalNotes          InternalNote[]
  statusHistory          StatusHistory[]
  assignments            ReportAssignment[]
  activityLogs           ActivityLog[]
  emailQueue             EmailQueue[]

  @@index([reportType])
  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

model ReportAssignment {
  id          String    @id @default(uuid())
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId    String    @map("report_id")
  admin       AdminUser @relation(fields: [adminId], references: [id])
  adminId     String    @map("admin_id")
  assignedBy AdminUser? @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedById String?  @map("assigned_by_id")
  assignedAt  DateTime  @default(now()) @map("assigned_at")

  @@unique([reportId, adminId])
  @@map("report_assignments")
}

model Message {
  id           String          @id @default(uuid())
  report       Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId     String          @map("report_id")
  authorType   MessageAuthor   @map("author_type")
  content      String
  createdAt    DateTime        @default(now()) @map("created_at")
  attachmentId String?  @unique @map("attachment_id")
  attachment   Attachment?     @relation(fields: [attachmentId], references: [id])

  @@index([reportId])
  @@index([createdAt])
  @@map("messages")
}

model Attachment {
  id               String              @id @default(uuid())
  report           Report              @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId         String              @map("report_id")
  originalFilename String              @map("original_filename")
  // UUID na disku — nikada originalno ime
  storedFilename   String              @map("stored_filename")
  mimeType         String              @map("mime_type")
  fileSize        BigInt              @map("file_size")
  uploadedByType   AttachmentUploader  @map("uploaded_by_type")
  createdAt        DateTime            @default(now()) @map("created_at")
  messageId        String?             @map("message_id")
  linkedMessage    Message?            // Back-relation za Message.attachment

  @@index([reportId])
  @@map("attachments")
}

model InternalNote {
  id        String    @id @default(uuid())
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String    @map("report_id")
  admin     AdminUser @relation(fields: [adminId], references: [id])
  adminId   String    @map("admin_id")
  content   String
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([reportId])
  @@map("internal_notes")
}

model StatusHistory {
  id        String       @id @default(uuid())
  report    Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String       @map("report_id")
  oldStatus ReportStatus? @map("old_status")
  newStatus ReportStatus  @map("new_status")
  admin     AdminUser?    @relation(fields: [adminId], references: [id])
  adminId   String?       @map("admin_id")
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([reportId])
  @@map("status_history")
}

model ActivityLog {
  id         String     @id @default(uuid())
  admin      AdminUser?  @relation(fields: [adminId], references: [id])
  adminId    String?     @map("admin_id")
  action     String
  report     Report?     @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reportId   String?     @map("report_id")
  reportType ReportType? @map("report_type")
  // Samo neosjetljivi metapodaci — nikada sadržaj prijave ili pristupni ključ
  details    String?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([reportId])
  @@index([adminId])
  @@index([createdAt])
  @@map("activity_log")
}

model EmailQueue {
  id         String      @id @default(uuid())
  recipient  String
  subject    String
  body       String
  report     Report?     @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reportId   String?     @map("report_id")
  reportType ReportType? @map("report_type")
  status     EmailStatus @default(PENDING)
  attempts   Int         @default(0)
  lastError  String?     @map("last_error")
  createdAt  DateTime    @default(now()) @map("created_at")
  sentAt    DateTime?    @map("sent_at")

  @@index([status])
  @@map("email_queue")
}
